      "title": "Edge → Django",
      "items": [
        "ingress-nginx on kind; Traefik + Let's Encrypt on Oracle k3s",
        "nginx serves the SPA and proxies /api, /admin, /swagger",
        "Apps: users, appointments, medical_records, billing, ai_agents"
      ]
    },
    {
      "dot": "violet",
      "title": "Claude agents",
      "items": [
        "Role-checked tools; every call audited",
        "propose_* tools only create approval cards",
        "Emergency guardrail before any model call"
      ]
    },
    {
      "dot": "amber",
      "title": "Background jobs",
      "items": [
