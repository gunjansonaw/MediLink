    "views": [
      {
        "id": "request-path",
        "label": "Request path",
        "focus": [
          "users",
          "ingress",
          "frontend",
          "backend",
          "postgres"
        ],
        "note": "One origin: the SPA and the API are served through the same host, so HttpOnly JWT cookies and CSRF need no cross-site setup."
      },
      {
        "id": "ai-agents",
        "label": "Claude agents",
        "focus": [
          "backend",
          "worker",
          "claude",
          "postgres"
        ],
        "note": "Chat runs a tool-use loop in the API; briefs, lab insights and daily agents run in the Celery worker."
      },
      {
        "id": "background-jobs",
        "label": "Background jobs",
        "focus": [
          "backend",
          "beat",
          "redis",
          "worker",
          "postgres"
        ],
        "note": "Model signals and the beat schedule enqueue tasks on Redis; the worker drains them and writes results to Postgres."
      }
    ]
  },
