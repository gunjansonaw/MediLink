# ===========================================================
# MediLink — Unified Environment Variables
# ===========================================================
# Copy this file:
#   cp .env.example backend/.env
#   cp .env.example frontend/.env
# Each service reads only the variables it needs.
# ===========================================================

# ─────────────────────────────────────
# BACKEND — Django Settings
# ─────────────────────────────────────

# Generate a strong key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-change-this-in-production

DEBUG=True

# Comma-separated list of allowed hosts (add your Railway domain in production)
ALLOWED_HOSTS=localhost,127.0.0.1

# ─────────────────────────────────────
# BACKEND — Database (Local PostgreSQL)
# ─────────────────────────────────────

DB_NAME=medilink
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ─────────────────────────────────────
# BACKEND — Database (Production)
# ─────────────────────────────────────
# On Railway, set DATABASE_URL directly. It overrides the DB_* vars above.
# Example: postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# ─────────────────────────────────────
# BACKEND — CORS
# ─────────────────────────────────────
# Comma-separated list of allowed origins (add your Vercel domain in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─────────────────────────────────────
# BACKEND — Celery (optional, not required for core features)
# ─────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ─────────────────────────────────────
# FRONTEND — React App
# ─────────────────────────────────────
# For local development, keep as-is.
# In production (Vercel), set this to your Railway backend URL:
# Example: https://medilink-api.up.railway.app/api
REACT_APP_API_URL=http://localhost:8000/api

# ─────────────────────────────────────
# BACKEND — Cookie-based JWT Auth
# ─────────────────────────────────────
# Domain for JWT HttpOnly cookies.
# Leave empty for localhost/development.
# In production set to your root domain (e.g. .example.com)
COOKIE_DOMAIN=

# ─────────────────────────────────────
# BACKEND — Cookie / proxy settings
# ─────────────────────────────────────
# "Secure" cookies require HTTPS. Defaults to True when DEBUG=False; set False for plain-HTTP clusters.
# COOKIE_SECURE=False
# Use None only when the frontend and API are on different sites (e.g. Vercel + Render)
JWT_AUTH_COOKIE_SAMESITE=Lax
# Run Celery tasks inline (for hosts without Redis/Celery workers)
CELERY_TASK_ALWAYS_EAGER=False

# ─────────────────────────────────────
# BACKEND — AI agents (Claude API)
# ─────────────────────────────────────
# Leave empty to run every AI feature in deterministic "rules-only" mode.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
# Max model calls per user turn, and per-user rate limit on AI endpoints
AI_MAX_AGENT_STEPS=8
AI_RATE_LIMIT=30/hour
